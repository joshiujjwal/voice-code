# Environment Variables — VoiceCode
# Copy this file to .env and fill in your values. Never commit .env.

# ── LLM / Code Generation ──────────────────────────────────────────────────────
# Required: OpenAI API key (used for Whisper transcription + GPT-4o code gen)
OPENAI_API_KEY=

# Optional: Anthropic API key (used if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# LLM provider: 'openai' (default) | 'anthropic'
LLM_PROVIDER=openai

# Model to use for code generation
# OpenAI: gpt-4o | gpt-4-turbo | gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet-20241022 | claude-3-haiku-20240307
LLM_MODEL=gpt-4o

# ── API Server ─────────────────────────────────────────────────────────────────
PORT=3001

# Allowed CORS origins (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Max requests per window per IP
RATE_LIMIT_MAX=50
# Window duration in ms (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# ── Dev ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
